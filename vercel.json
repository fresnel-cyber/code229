{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://code229-978a6.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/entrainement",
      "destination": "/api/page?route=/entrainement"
    },
    {
      "source": "/fiches",
      "destination": "/api/page?route=/fiches"
    },
    {
      "source": "/progression",
      "destination": "/api/page?route=/progression"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "index.html"
    }
  },
  "headers": [
    {
      "source": "/__/auth/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://www.code229.online"
        }
      ]
    },
    {
      "source": "/((?!__/auth).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://www.code229.online"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://analytics.tiktok.com https://*.tiktok.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://analytics.tiktok.com https://*.tiktok.com; frame-src 'self' https://code229-978a6.firebaseapp.com https://accounts.google.com; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
        }
      ]
    }
  ]
}
