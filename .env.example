# Copier ce fichier en .env.local pour le développement local (jamais commité).
# En production, ces valeurs vivent uniquement dans Vercel → Project Settings → Environment Variables.

# Prestataire de paiement actif : "kpay" ou "fedapay".
# Les deux intégrations restent présentes dans le projet ; cette variable
# décide simplement laquelle /api/create-payment utilise.
PAYMENT_PROVIDER=kpay

# --- KPay (mode TEST tant que la clé commence par kpay_test_) ---
# Tableau de bord KPay → API. Ne JAMAIS exposer côté client.
KPAY_API_KEY=kpay_test_xxxxxxxxxxxx
KPAY_SECRET_KEY=xxxxxxxxxxxxxxxx

# Secret de signature des webhooks KPay, SI le tableau de bord en fournit un
# distinct de la clé secrète. Laisser vide sinon : KPAY_SECRET_KEY sert alors
# de repli.
KPAY_WEBHOOK_SECRET=

# Surcharge de la base d'API KPay, utile si l'URL d'initiation diffère de
# celle par défaut (https://admin.kpay.site) — évite un redéploiement de code.
KPAY_BASE_URL=

# --- FedaPay (conservé, réactivable via PAYMENT_PROVIDER=fedapay) ---
# Clé secrète FedaPay (Dashboard FedaPay → Réglages → Clés API). Ne JAMAIS exposer côté client.
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxx

# Secret de vérification de signature webhook (Dashboard FedaPay → Webhooks → votre endpoint).
FEDAPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# "sandbox" pendant les tests, "live" une fois prêt pour de vrais paiements.
FEDAPAY_ENV=sandbox

# Clé de compte de service Firebase (Admin SDK), au format JSON sur une seule ligne.
# Firebase Console → Paramètres du projet → Comptes de service → Générer une nouvelle clé privée.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"code229-978a6", "...":"..."}

# URL de base de l'app déployée, utilisée pour construire callback_url.
APP_BASE_URL=https://www.code229.online
